@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .

<default-reverb.ttl> a pset:Preset ;
    lv2:appliesTo <http://guitarix.sourceforge.net/plugins/gx_zita_rev1_stereo#_zita_rev1_stereo> ;
    rdfs:label "default-reverb" ;
    lv2:port [
        lv2:symbol "level" ;
        pset:value 0.0
    ] , [
        lv2:symbol "EQ2_FREQ" ;
        pset:value 1500.0
    ] , [
        lv2:symbol "EQ1_LEVEL" ;
        pset:value 0.0
    ] , [
        lv2:symbol "EQ1_FREQ" ;
        pset:value 315.0
    ] , [
        lv2:symbol "IN_DELAY" ;
        pset:value 60.0
    ] , [
        lv2:symbol "LOW_RT60" ;
        pset:value 3.0
    ] , [
        lv2:symbol "LF_X" ;
        pset:value 200.0
    ] , [
        lv2:symbol "HF_DAMPING" ;
        pset:value 6000.0
    ] , [
        lv2:symbol "MID_RT60" ;
        pset:value 2.200000047683716
    ] , [
        lv2:symbol "DRY_WET_MIX" ;
        pset:value -0.5
    ] , [
        lv2:symbol "EQ2_LEVEL" ;
        pset:value 0.0
    ] .
