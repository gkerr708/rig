# Metal lead (GxMetalHead)
# Saturated lead with quarter-note delay and big reverb; phaser ready to switch on.

in  = hw_USB_0:capture_AUX1                 # Scarlett Solo, instrument input
out = Scarlett_Solo*:playback_FL, Scarlett_Solo*:playback_FR
latency = 64

[gate] gate_mono                        # cuts hiss between notes
  gt = -50dB                            # threshold: lower if notes get chopped
  at = 1                                # attack ms
  rt = 80                               # release ms

[amp] metal_head                        # GxMetalHead
  HIGHGAIN = on
  DRIVE = 0.6
  TONE = 0.55

[cab] gx_cabinet
  c_model = Mesa Style

[phaser] phaser_stereo  off             # switch on for solos
  rate = 0.4                            # Hz
  filters = 4
  dry = 0dB
  wet = -6dB

[delay] gx_digital_delay_st
  BPM = 120
  NOTES = 1/4note
  FEEDBACK = 35
  LEVEL = 30
  MODE = presence

[reverb] gx_zita_rev1_stereo
  MID_RT60 = 3
  DRY_WET_MIX = -0.3

[limit] limiter_stereo                  # safety net so a hot amp can't blast your ears
  th = -1dB                             # ceiling
  g_out = -3dB                          # overall volume: change this one
